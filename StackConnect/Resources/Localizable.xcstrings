    "Account-wide permissions reach every app, so this account (limited to some apps) can't change them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontoweite Berechtigungen gelten für jede App, daher kann dieses (auf einige Apps beschränkte) Konto sie nicht ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los permisos de toda la cuenta afectan a todas las apps, así que esta cuenta (limitada a algunas apps) no puede cambiarlos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los permisos de toda la cuenta afectan a todas las apps, así que esta cuenta (limitada a algunas apps) no puede cambiarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autorisations du compte s'appliquent à toutes les apps : ce compte (limité à certaines apps) ne peut pas les modifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I permessi a livello di account valgono per tutte le app, quindi questo account (limitato ad alcune app) non può modificarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウント全体の権限はすべてのアプリに及ぶため、一部のアプリに限定されたこのアカウントでは変更できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정 전체 권한은 모든 앱에 적용되므로 일부 앱으로 제한된 이 계정은 변경할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accountbrede rechten gelden voor elke app, dus dit account (beperkt tot enkele apps) kan ze niet wijzigen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permissões da conta inteira valem para todos os apps, então esta conta (limitada a alguns apps) não pode alterá-las."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permissões da conta inteira valem para todos os apps, então esta conta (limitada a alguns apps) não pode alterá-las."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешения уровня аккаунта действуют для всех приложений, поэтому этот аккаунт (ограниченный некоторыми приложениями) не может их менять."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontoomfattande behörigheter gäller alla appar, så det här kontot (begränsat till vissa appar) kan inte ändra dem."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帳戶層級權限適用於每個 App，因此此帳號（僅限部分 App）無法變更。"
          }
        }
      }
    },
