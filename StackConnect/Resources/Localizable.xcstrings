    "App permissions apply to one app only. A user with no account permission and no app sees nothing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-Berechtigungen gelten nur für eine App. Ein Nutzer ohne Kontoberechtigung und ohne App sieht nichts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los permisos de app solo se aplican a una app. Un usuario sin permisos de cuenta ni apps no ve nada."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los permisos de app solo se aplican a una app. Un usuario sin permisos de cuenta ni apps no ve nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autorisations d'app ne s'appliquent qu'à une seule app. Un utilisateur sans autorisation de compte ni app ne voit rien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I permessi dell'app valgono per una sola app. Un utente senza permessi dell'account né app non vede nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの権限は 1 つのアプリにのみ適用されます。アカウントの権限もアプリもないユーザーには何も表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 권한은 하나의 앱에만 적용됩니다. 계정 권한과 앱이 모두 없는 사용자는 아무것도 볼 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-rechten gelden voor één app. Een gebruiker zonder accountrecht en zonder app ziet niets."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As permissões de app valem para um app só. Um usuário sem permissão de conta e sem app não vê nada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As permissões de app valem para um app só. Um usuário sem permissão de conta e sem app não vê nada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешения приложения действуют только для одного приложения. Пользователь без разрешений аккаунта и приложений ничего не увидит."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appbehörigheter gäller bara en app. En användare utan kontobehörighet och utan app ser ingenting."
          }
