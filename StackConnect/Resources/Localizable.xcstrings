    "Headers added by the network stack while sending (Host, Content-Length, User-Agent and the Apple ID session cookies) aren't listed." : {
      "comment" : "Network audit detail: known limit of the Rust core's request headers.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Header, die der Netzwerk-Stack beim Senden hinzufügt (Host, Content-Length, User-Agent und die Cookies der Apple-ID-Sitzung), werden nicht aufgeführt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cabeceras que añade la pila de red al enviar (Host, Content-Length, User-Agent y las cookies de la sesión de Apple ID) no se muestran."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los encabezados que agrega la pila de red al enviar (Host, Content-Length, User-Agent y las cookies de la sesión del Apple ID) no aparecen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les en-têtes ajoutés par la pile réseau lors de l’envoi (Host, Content-Length, User-Agent et les cookies de session Identifiant Apple) ne sont pas listés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le intestazioni aggiunte dallo stack di rete durante l'invio (Host, Content-Length, User-Agent e i cookie della sessione Apple ID) non sono elencate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信時にネットワークスタックが追加するヘッダ（Host、Content-Length、User-Agent、Apple ID セッションの Cookie）は表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전송 중 네트워크 스택이 추가하는 헤더(Host, Content-Length, User-Agent 및 Apple ID 세션 쿠키)는 표시되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Headers die de netwerkstack tijdens het verzenden toevoegt (Host, Content-Length, User-Agent en de Apple ID-sessiecookies) worden niet vermeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cabeçalhos adicionados pela camada de rede no envio (Host, Content-Length, User-Agent e os cookies da sessão do Apple ID) não aparecem."
          }
        },
        "pt-PT" : {
