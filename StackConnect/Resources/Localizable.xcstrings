    "Report generation was paused due to inactivity, so this data may be out of date." : {
      "comment" : "A warning message displayed when a report generation is paused due to inactivity, explaining that the displayed data may be outdated.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Berichterstellung wurde wegen Inaktivität pausiert, daher sind diese Daten möglicherweise veraltet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La generación de informes se pausó por inactividad, por lo que estos datos pueden estar desactualizados."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La generación de reportes se pausó por inactividad, así que estos datos podrían estar desactualizados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La génération des rapports a été suspendue pour cause d’inactivité, ces données peuvent donc être obsolètes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La generazione dei report è stata sospesa per inattività, quindi questi dati potrebbero non essere aggiornati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非アクティブのためレポートの生成が一時停止されたので、このデータは最新でない可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비활성 상태로 인해 보고서 생성이 일시 중지되어 이 데이터는 최신이 아닐 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het genereren van rapporten is gepauzeerd wegens inactiviteit, dus deze gegevens zijn mogelijk verouderd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A geração do relatório foi pausada por inatividade, então estes dados podem estar desatualizados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A geração de relatórios foi pausada por inatividade, pelo que estes dados podem estar desatualizados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
