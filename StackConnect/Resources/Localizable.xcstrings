    "A draft stays on the track without being served to anyone. Staged rollout is available for production and open testing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Entwurf bleibt auf dem Track, ohne an jemanden ausgeliefert zu werden. Die gestaffelte Einführung gibt es für die Produktion und offene Tests."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un borrador se queda en el canal sin ofrecerse a nadie. El lanzamiento escalonado está disponible para producción y pruebas abiertas."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un borrador se queda en el canal sin ofrecerse a nadie. El lanzamiento escalonado está disponible para producción y pruebas abiertas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un brouillon reste sur le canal sans être proposé à personne. Le déploiement progressif est disponible pour la production et les tests ouverts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una bozza resta sul canale senza essere distribuita a nessuno. Il rollout graduale è disponibile per produzione e test aperti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下書きはトラックに残り、誰にも配信されません。段階的公開は正式版とオープンテストで利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초안은 누구에게도 제공되지 않고 트랙에 남아 있습니다. 단계적 출시는 프로덕션 및 공개 테스트에서 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een concept blijft op de track zonder aan iemand te worden geleverd. Gefaseerde uitrol is beschikbaar voor productie en open tests."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um rascunho fica na faixa sem ser entregue a ninguém. O lançamento gradual está disponível para produção e teste aberto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um rascunho fica na faixa sem ser disponibilizado a ninguém. O lançamento gradual está disponível para produção e teste aberto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Черновик остаётся в треке и никому не выдаётся. Поэтапное развёртывание доступно для рабочей версии и открытого тестирования."
          }
        },
        "sv" : {
          "stringUnit" : {
