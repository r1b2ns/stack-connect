        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下次只需輸入驗證碼。儲存在此裝置的鑰匙圈中。"
          }
        }
      }
    },
    "You've hit Apple's limit. Discard a draft to submit a new version." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben das Limit von Apple erreicht. Verwerfen Sie einen Entwurf, um eine neue Version einzureichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has alcanzado el límite de Apple. Descarta un borrador para enviar una nueva versión."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcanzaste el límite de Apple. Descarta un borrador para enviar una nueva versión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez atteint la limite d'Apple. Abandonnez un brouillon pour soumettre une nouvelle version."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai raggiunto il limite di Apple. Scarta una bozza per inviare una nuova versione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple の上限に達しました。新しいバージョンを提出するには下書きを破棄してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple의 한도에 도달했습니다. 새 버전을 제출하려면 초안을 삭제하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
