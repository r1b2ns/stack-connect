    ".scexport files are encrypted with the password set when exporting." : {
      "comment" : "Account wizard: caption of the import step.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".scexport-Dateien sind mit dem Passwort verschlüsselt, das beim Export festgelegt wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos .scexport se cifran con la contraseña definida al exportar."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos .scexport se cifran con la contraseña definida al exportar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers .scexport sont chiffrés avec le mot de passe défini lors de l’exportation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file .scexport sono cifrati con la password impostata durante l'esportazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".scexport ファイルは、書き出し時に設定したパスワードで暗号化されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".scexport 파일은 내보낼 때 설정한 비밀번호로 암호화됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".scexport-bestanden zijn versleuteld met het wachtwoord dat bij het exporteren is ingesteld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos .scexport são criptografados com a senha definida na exportação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ficheiros .scexport são encriptados com a palavra-passe definida na exportação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файлы .scexport зашифрованы паролем, заданным при экспорте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".scexport-filer krypteras med lösenordet som angavs vid exporten."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".scexport 檔案會以匯出時設定的密碼加密。"
          }
        }
      }
    },
