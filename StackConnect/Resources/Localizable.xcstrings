    "App Store Connect has agreements waiting to be accepted by the Account Holder. Some data may not sync until then." : {
      "comment" : "Account status notice: pending App Store Connect agreements.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In App Store Connect warten Vereinbarungen darauf, vom Account Holder akzeptiert zu werden. Bis dahin werden manche Daten eventuell nicht synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect tiene acuerdos pendientes de aceptación por el titular de la cuenta. Es posible que algunos datos no se sincronicen hasta entonces."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect tiene acuerdos pendientes de aceptación por el titular de la cuenta. Es posible que algunos datos no se sincronicen hasta entonces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect a des contrats en attente d'acceptation par le titulaire du compte. Certaines données risquent de ne pas se synchroniser d'ici là."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect ha accordi in attesa di essere accettati dal titolare dell'account. Fino ad allora alcuni dati potrebbero non sincronizzarsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect に、アカウント保有者の同意を待っている契約があります。同意されるまで、一部のデータが同期されない場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect에 계정 소유자의 동의를 기다리는 계약이 있습니다. 그때까지 일부 데이터가 동기화되지 않을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect heeft overeenkomsten die nog door de accounthouder moeten worden geaccepteerd. Tot die tijd worden sommige gegevens mogelijk niet gesynchroniseerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O App Store Connect tem contratos aguardando a aceitação do titular da conta. Alguns dados podem não sincronizar até lá."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O App Store Connect tem contratos a aguardar a aceitação do titular da conta. Alguns dados podem não ser sincronizados até lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В App Store Connect есть соглашения, ожидающие принятия владельцем аккаунта. До этого часть данных может не синхронизироваться."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect har avtal som väntar på att godkännas av kontoinnehavaren. Vissa data kanske inte synkroniseras förrän dess."
          }
        },
        "zh-Hant" : {
