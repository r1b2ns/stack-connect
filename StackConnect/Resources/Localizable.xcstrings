    "Sign in with the Apple ID (secure password proof, the password itself is never sent)." : {
      "comment" : "Network audit purpose: the core's Apple ID sign-in start (SRP).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der Apple-ID anmelden (sicherer Passwortnachweis, das Passwort selbst wird nie gesendet)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciar sesión con el Apple ID (prueba segura de la contraseña; la contraseña nunca se envía)."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciar sesión con el Apple ID (prueba segura de la contraseña; la contraseña nunca se envía)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexion avec l’Identifiant Apple (preuve de mot de passe sécurisée, le mot de passe lui-même n’est jamais envoyé)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con l'Apple ID (prova sicura della password, la password non viene mai inviata)."
          }
        },
        "ja" : {
          "stringUnit" : {
