    "Do this once in Google Cloud and Play Console. Access can take a few hours to apply." : {
      "comment" : "Account wizard: caption of the Google Play service account step.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmalig in Google Cloud und der Play Console erledigen. Es kann einige Stunden dauern, bis der Zugriff wirksam wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazlo una vez en Google Cloud y Play Console. El acceso puede tardar unas horas en aplicarse."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazlo una sola vez en Google Cloud y Play Console. El acceso puede tardar unas horas en aplicarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À faire une seule fois dans Google Cloud et Play Console. L’accès peut prendre quelques heures pour s’appliquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da fare una sola volta in Google Cloud e Play Console. L'accesso può richiedere alcune ore per essere applicato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Cloud と Play Console で一度だけ行ってください。アクセスが反映されるまで数時間かかることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Cloud와 Play Console에서 한 번만 하면 됩니다. 접근 권한이 적용되기까지 몇 시간이 걸릴 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doe dit eenmalig in Google Cloud en Play Console. Het kan enkele uren duren voordat de toegang actief is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça isto uma vez no Google Cloud e no Play Console. O acesso pode levar algumas horas para valer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça isto uma vez no Google Cloud e na Play Console. O acesso pode demorar algumas horas a ficar ativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это нужно сделать один раз в Google Cloud и Play Console. Доступ может вступить в силу через несколько часов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör detta en gång i Google Cloud och Play Console. Det kan ta några timmar innan åtkomsten gäller."
          }
