          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот JSON не является ключом сервисного аккаунта. В Google Cloud откройте «IAM и администрирование › Сервисные аккаунты», выберите аккаунт и создайте ключ JSON в разделе «Ключи»."
          }
        },
        "sv" : {
          "stringUnit" : {
