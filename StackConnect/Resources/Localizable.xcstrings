    "Rejection reasons and review history aren't shared by the Google Play API. Open Play Console for policy details." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ablehnungsgründe und Prüfverlauf werden von der Google Play API nicht bereitgestellt. Öffne die Play Console für Richtliniendetails."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La API de Google Play no comparte los motivos de rechazo ni el historial de revisiones. Abre Play Console para ver los detalles de las políticas."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La API de Google Play no comparte los motivos de rechazo ni el historial de revisiones. Abre Play Console para ver los detalles de las políticas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’API Google Play ne fournit ni les motifs de refus ni l’historique des examens. Ouvrez Play Console pour les détails des règles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’API di Google Play non fornisce i motivi del rifiuto né la cronologia delle revisioni. Apri Play Console per i dettagli sulle norme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "却下理由と審査履歴は Google Play API では提供されません。ポリシーの詳細は Play Console で確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play API는 거부 사유와 검토 기록을 제공하지 않습니다. 정책 세부정보는 Play Console에서 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afwijzingsredenen en beoordelingsgeschiedenis worden niet gedeeld door de Google Play API. Open Play Console voor beleidsdetails."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os motivos de rejeição e o histórico de revisões não são compartilhados pela API do Google Play. Abra o Play Console para ver os detalhes da política."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os motivos de rejeição e o histórico de revisões não são partilhados pela API do Google Play. Abra a Play Console para ver os detalhes da política."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API Google Play не сообщает причины отклонения и историю проверок. Подробности о правилах — в Play Console."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslagsorsaker och granskningshistorik delas inte av Google Play API. Öppna Play Console för policyinformation."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play API 不提供拒絕原因與審查記錄。請前往 Play Console 查看政策詳情。"
          }
        }
