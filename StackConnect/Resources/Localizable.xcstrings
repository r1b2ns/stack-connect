    "The token is masked. The command returns 401 until you put a valid token in." : {
      "comment" : "Network audit: note for a masked cURL.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Token ist maskiert. Der Befehl liefert 401, bis du ein gültiges Token einsetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El token está enmascarado. El comando devuelve 401 hasta que pongas un token válido."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El token está enmascarado. El comando devuelve 401 hasta que pongas un token válido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
