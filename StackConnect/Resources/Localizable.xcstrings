    },
    "This may take a moment while we download report data." : {
      "comment" : "A description below the progress indicator in the \"Loading analytics...\" state.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
