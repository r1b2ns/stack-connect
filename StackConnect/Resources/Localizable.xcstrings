        }
      }
    },
    "Your Google sign-in expired or was revoked. Add the account again with Sign in with Google, using the same Google account, to restore access." : {
      "comment" : "Google sign-in error: a Google login without a known e-mail expired.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Google-Anmeldung ist abgelaufen oder wurde widerrufen. Füge das Konto erneut über „Mit Google anmelden“ mit demselben Google-Konto hinzu, um den Zugriff wiederherzustellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu inicio de sesión de Google caducó o se revocó. Vuelve a añadir la cuenta con Iniciar sesión con Google, usando la misma cuenta de Google, para recuperar el acceso."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu inicio de sesión de Google caducó o se revocó. Vuelve a agregar la cuenta con Iniciar sesión con Google, usando la misma cuenta de Google, para recuperar el acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre connexion Google a expiré ou a été révoquée. Ajoutez de nouveau le compte avec Se connecter avec Google, en utilisant le même compte Google, pour rétablir l’accès."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo accesso Google è scaduto o è stato revocato. Aggiungi di nuovo l’account con Accedi con Google, usando lo stesso account Google, per ripristinare l’accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google サインインの有効期限が切れたか、取り消されました。アクセスを復元するには、同じ Google アカウントを使って「Google でログイン」でアカウントを再度追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 로그인이 만료되었거나 취소되었습니다. 접근 권한을 복원하려면 같은 Google 계정을 사용해 ‘Google 계정으로 로그인’으로 계정을 다시 추가하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je Google-login is verlopen of ingetrokken. Voeg het account opnieuw toe via ‘Inloggen met Google’ met hetzelfde Google-account om de toegang te herstellen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu login do Google expirou ou foi revogado. Adicione a conta de novo com Fazer login com o Google, usando a mesma conta do Google, para recuperar o acesso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua sessão Google expirou ou foi revogada. Adicione a conta novamente com Iniciar sessão com o Google, usando a mesma conta Google, para recuperar o acesso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш вход в Google истёк или был отозван. Чтобы восстановить доступ, снова добавьте аккаунт через «Войти через аккаунт Google», используя тот же аккаунт Google."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Google-inloggning har upphört eller återkallats. Lägg till kontot igen med ”Logga in med Google” och samma Google-konto för att återställa åtkomsten."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Google 登入已過期或遭撤銷。若要恢復存取權，請使用同一個 Google 帳戶，透過「使用 Google 帳戶登入」重新新增此帳戶。"
          }
        }
      }
    },
    "Your Google sign-in expired or was revoked. Sign in again with the same Google account to keep using this account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Google-Anmeldung ist abgelaufen oder wurde widerrufen. Melde dich erneut mit demselben Google-Konto an, um dieses Konto weiter zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu inicio de sesión de Google caducó o se revocó. Vuelve a iniciar sesión con la misma cuenta de Google para seguir usando esta cuenta."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu inicio de sesión de Google caducó o se revocó. Vuelve a iniciar sesión con la misma cuenta de Google para seguir usando esta cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre connexion Google a expiré ou a été révoquée. Reconnectez-vous avec le même compte Google pour continuer à utiliser ce compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo accesso Google è scaduto o è stato revocato. Accedi di nuovo con lo stesso account Google per continuare a usare questo account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google サインインの有効期限が切れたか、取り消されました。このアカウントを引き続き使用するには、同じ Google アカウントで再度サインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 로그인이 만료되었거나 취소되었습니다. 이 계정을 계속 사용하려면 같은 Google 계정으로 다시 로그인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je Google-login is verlopen of ingetrokken. Log opnieuw in met hetzelfde Google-account om dit account te blijven gebruiken."
