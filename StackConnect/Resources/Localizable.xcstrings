    "Sign in again with the same Apple ID. Its App Store Connect accounts start working again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich erneut mit derselben Apple-ID an. Ihre App Store Connect-Accounts funktionieren dann wieder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a iniciar sesión con el mismo Apple ID. Sus cuentas de App Store Connect volverán a funcionar."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a iniciar sesión con el mismo Apple ID. Sus cuentas de App Store Connect volverán a funcionar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnectez-vous avec le même Identifiant Apple. Ses comptes App Store Connect fonctionneront à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi di nuovo con lo stesso Apple ID. I suoi account App Store Connect torneranno a funzionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ Apple ID で再度サインインしてください。その App Store Connect アカウントが再び使えるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 Apple ID로 다시 로그인하세요. 해당 App Store Connect 계정이 다시 작동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log opnieuw in met dezelfde Apple ID. De App Store Connect-accounts ervan werken dan weer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça login de novo com o mesmo Apple ID. As contas do App Store Connect voltam a funcionar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie sessão novamente com o mesmo ID Apple. As contas do App Store Connect voltam a funcionar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите снова с тем же Apple ID. Его учетные записи App Store Connect снова заработают."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logga in igen med samma Apple-ID. Dess App Store Connect-konton fungerar då igen."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請使用相同的 Apple ID 重新登入。其 App Store Connect 帳號將恢復運作。"
          }
        }
      }
    },
    "Sign in on Google's page with the account you use for %@, then pick what to add. No key file needed." : {
      "comment" : "Add Account method chooser and connection guide: the Google sign-in method. The placeholder is the service being connected, e.g. Firebase.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich auf der Seite von Google mit dem Konto an, das du für %@ verwendest, und wähle dann aus, was hinzugefügt werden soll. Keine Schlüsseldatei nötig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in on Google's page with the account you use for %@, then pick what to add. No key file needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión en la página de Google con la cuenta que usas en %@ y elige qué añadir. No necesitas ningún archivo de clave."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión en la página de Google con la cuenta que usas en %@ y elige qué agregar. No necesitas ningún archivo de clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous sur la page de Google avec le compte que vous utilisez pour %@, puis choisissez ce qu’il faut ajouter. Aucun fichier de clé n’est nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi alla pagina di Google con l’account che usi per %@, poi scegli cosa aggiungere. Nessun file di chiave necessario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ で使っているアカウントで Google のページからサインインし、追加するものを選びます。キーファイルは不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 사용하는 계정으로 Google 페이지에서 로그인한 다음 추가할 항목을 선택하세요. 키 파일이 필요 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log op de pagina van Google in met het account dat je voor %@ gebruikt en kies daarna wat je wilt toevoegen. Geen sleutelbestand nodig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça login na página do Google com a conta que você usa no %@ e escolha o que adicionar. Não precisa de arquivo de chave."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie sessão na página da Google com a conta que usa no %@ e escolha o que adicionar. Não precisa de ficheiro de chave."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите на странице Google с аккаунтом, который вы используете для %@, затем выберите, что добавить. Файл ключа не нужен."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logga in på Googles sida med kontot du använder för %@ och välj sedan vad som ska läggas till. Ingen nyckelfil behövs."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Google 的頁面上使用你在 %@ 所用的帳戶登入，然後選擇要加入的項目。不需要金鑰檔案。"
          }
        }
      }
    },
