    "Campaigns sent from StackConnect will appear here. Firebase does not provide a public API to list console-created campaigns." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über StackConnect gesendete Kampagnen werden hier angezeigt. Firebase bietet keine öffentliche API zum Auflisten von in der Konsole erstellten Kampagnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las campañas enviadas desde StackConnect aparecerán aquí. Firebase no proporciona una API pública para listar campañas creadas en la consola."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las campañas enviadas desde StackConnect aparecerán aquí. Firebase no proporciona una API pública para listar campañas creadas en la consola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les campagnes envoyées depuis StackConnect apparaîtront ici. Firebase ne fournit pas d'API publique pour lister les campagnes créées dans la console."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le campagne inviate da StackConnect appariranno qui. Firebase non fornisce un'API pubblica per elencare le campagne create nella console."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect から送信したキャンペーンがここに表示されます。Firebase は、コンソールで作成したキャンペーンを一覧表示する公開 API を提供していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect에서 보낸 캠페인이 여기에 표시됩니다. Firebase는 콘솔에서 생성한 캠페인을 나열하는 공개 API를 제공하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanuit StackConnect verzonden campagnes verschijnen hier. Firebase biedt geen openbare API om in de console gemaakte campagnes weer te geven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
