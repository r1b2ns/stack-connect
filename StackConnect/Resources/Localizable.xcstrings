        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es la telemetría propia de StackConnect: sus identificadores, claves y tokens permanecen ocultos en todos los formatos, cURL incluido."
          }
        },
        "es-MX" : {
          "stringUnit" : {
