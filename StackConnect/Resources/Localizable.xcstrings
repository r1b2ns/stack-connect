          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «Download API Key» — скачать ключ можно только один раз. Чтобы загрузить его, используйте «Импортировать файл .p8» выше."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på ”Ladda ned API-nyckel” – det är enda gången du kan ladda ned den. Använd ”Importera .p8-fil” ovan för att läsa in den."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
