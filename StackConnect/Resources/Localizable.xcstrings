    "Accounts with a security key as their second factor can't sign in here yet. Use an App Store Connect API key instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accounts mit einem Sicherheitsschlüssel als zweitem Faktor können sich hier noch nicht anmelden. Verwende stattdessen einen App Store Connect-API-Schlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cuentas que usan una llave de seguridad como segundo factor aún no pueden iniciar sesión aquí. Usa una clave de API de App Store Connect."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cuentas que usan una llave de seguridad como segundo factor aún no pueden iniciar sesión aquí. Usa una clave de API de App Store Connect."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les comptes qui utilisent une clé de sécurité comme second facteur ne peuvent pas encore se connecter ici. Utilisez plutôt une clé d'API App Store Connect."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli account con una chiave di sicurezza come secondo fattore non possono ancora accedere qui. Usa invece una chiave API di App Store Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2つ目の認証要素にセキュリティキーを使うアカウントは、まだここでサインインできません。代わりに App Store Connect API キーを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보안 키를 두 번째 인증 수단으로 사용하는 계정은 아직 여기에서 로그인할 수 없습니다. 대신 App Store Connect API 키를 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accounts met een beveiligingssleutel als tweede factor kunnen hier nog niet inloggen. Gebruik in plaats daarvan een App Store Connect API-sleutel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contas com chave de segurança como segundo fator ainda não podem fazer login aqui. Use uma chave de API do App Store Connect."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As contas com chave de segurança como segundo fator ainda não podem iniciar sessão aqui. Use antes uma chave de API do App Store Connect."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учетные записи с ключом безопасности в качестве второго фактора пока не могут войти здесь. Используйте ключ API App Store Connect."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konton med en säkerhetsnyckel som andra faktor kan inte logga in här ännu. Använd en API-nyckel för App Store Connect i stället."
          }
