    "This Google account can't see any Firebase project. Sign in with the account that has access in the Firebase console." : {
      "comment" : "Add Account (Firebase): the signed-in Google account sees no Firebase project.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Google-Konto sieht kein Firebase-Projekt. Melde dich mit dem Konto an, das in der Firebase Console Zugriff hat."
