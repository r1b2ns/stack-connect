    "Token expired at %@. It can't be included: the command would return 401." : {
      "comment" : "Network audit export: the token expired. Argument: time.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token ist um %@ abgelaufen. Es kann nicht aufgenommen werden: Der Befehl würde 401 liefern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El token caducó a las %@. No se puede incluir: el comando devolvería 401."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El token caducó a las %@. No se puede incluir: el comando devolvería 401."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeton a expiré à %@. Il ne peut pas être inclus : la commande renverrait 401."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token scaduto alle %@. Non può essere incluso: il comando restituirebbe 401."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トークンは %@ に期限切れになりました。含めることはできません。コマンドは 401 を返します。"
          }
        },
        "ko" : {
          "stringUnit" : {
