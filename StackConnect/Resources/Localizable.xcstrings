    "New users on %@ stop getting %@. Users who already updated keep it." : {
      "comment" : "Google Play halt confirmation. Arguments: track name, release name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Nutzer auf %1$@ erhalten %2$@ nicht mehr. Wer bereits aktualisiert hat, behält die Version."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los usuarios nuevos de %1$@ dejan de recibir %2$@. Quienes ya actualizaron la conservan."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los usuarios nuevos de %1$@ dejan de recibir %2$@. Quienes ya actualizaron la conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux utilisateurs de %1$@ ne reçoivent plus %2$@. Ceux qui ont déjà mis à jour la conservent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nuovi utenti di %1$@ non ricevono più %2$@. Chi ha già aggiornato la mantiene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ の新しいユーザーには %2$@ が配信されなくなります。すでにアップデートしたユーザーはそのまま使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 새 사용자는 더 이상 %2$@을(를) 받지 않습니다. 이미 업데이트한 사용자는 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe gebruikers op %1$@ krijgen %2$@ niet meer. Wie al heeft geüpdatet, houdt de versie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novos usuários de %1$@ deixam de receber %2$@. Quem já atualizou mantém a versão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novos utilizadores de %1$@ deixam de receber %2$@. Quem já atualizou mantém a versão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новые пользователи %1$@ перестанут получать %2$@. Те, кто уже обновился, сохранят его."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nya användare på %1$@ får inte längre %2$@. De som redan har uppdaterat behåller den."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 的新使用者將不再取得 %2$@。已更新的使用者會保留此版本。"
          }
        }
      }
    },
