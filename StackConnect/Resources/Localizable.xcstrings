          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un bundle déjà envoyé sur Google Play (par CI ou Play Console). L’envoi d’un nouveau .aab depuis le téléphone n’est pas pris en charge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un bundle già caricato su Google Play (da CI o Play Console). Il caricamento di un nuovo .aab dal telefono non è supportato."
