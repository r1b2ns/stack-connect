    "Pick a bundle that was already uploaded to Google Play (by CI or Play Console). Uploading a new .aab from the phone isn't supported." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein Bundle, das bereits zu Google Play hochgeladen wurde (per CI oder Play Console). Das Hochladen einer neuen .aab vom Telefon wird nicht unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un bundle ya subido a Google Play (por CI o Play Console). No se admite subir un .aab nuevo desde el teléfono."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
