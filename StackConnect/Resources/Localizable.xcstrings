    "StackConnect analytics: screens visited and buttons tapped. Turn it off in Settings › Privacy." : {
      "comment" : "Network audit: purpose of the analytics hosts.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect-Analysen: besuchte Bildschirme und getippte Tasten. Deaktiviere dies unter Einstellungen › Datenschutz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analíticas de StackConnect: pantallas visitadas y botones pulsados. Desactívalas en Ajustes › Privacidad."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analytics de StackConnect: pantallas visitadas y botones tocados. Desactívalo en Configuración › Privacidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyses de StackConnect : écrans visités et boutons touchés. Désactivez-les dans Réglages › Confidentialité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analisi di StackConnect: schermate visitate e pulsanti toccati. Disattivale in Impostazioni › Privacy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
