            "value" : "Apple ID로 로그인합니다(안전한 암호 증명을 사용하며, 암호 자체는 전송되지 않음)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log in met de Apple ID (veilig wachtwoordbewijs, het wachtwoord zelf wordt nooit verzonden)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
