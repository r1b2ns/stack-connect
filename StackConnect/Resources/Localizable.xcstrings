    "Must be a Google account. Google Play doesn't ask for a name: it comes from the person's Google account once they accept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muss ein Google-Konto sein. Google Play fragt nicht nach einem Namen: Er stammt aus dem Google-Konto der Person, sobald sie annimmt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debe ser una cuenta de Google. Google Play no pide un nombre: se toma de la cuenta de Google de la persona cuando acepta."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debe ser una cuenta de Google. Google Play no pide un nombre: se toma de la cuenta de Google de la persona cuando acepta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doit être un compte Google. Google Play ne demande pas de nom : il provient du compte Google de la personne une fois qu'elle accepte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deve essere un account Google. Google Play non chiede un nome: arriva dall'account Google della persona quando accetta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google アカウントである必要があります。Google Play は名前を求めません。承諾後に本人の Google アカウントから取得されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 계정이어야 합니다. Google Play는 이름을 묻지 않으며, 수락하면 해당 사용자의 Google 계정에서 가져옵니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moet een Google-account zijn. Google Play vraagt geen naam: die komt uit het Google-account van de persoon zodra die accepteert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precisa ser uma conta Google. O Google Play não pede nome: ele vem da conta Google da pessoa quando ela aceita."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precisa ser uma conta Google. O Google Play não pede nome: ele vem da conta Google da pessoa quando ela aceita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это должен быть аккаунт Google. Google Play не запрашивает имя: оно появится из аккаунта Google, когда человек примет приглашение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Måste vara ett Google-konto. Google Play frågar inte efter namn: det hämtas från personens Google-konto när hen accepterar."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必須是 Google 帳戶。Google Play 不會要求名稱：對方接受後會從其 Google 帳戶取得。"
