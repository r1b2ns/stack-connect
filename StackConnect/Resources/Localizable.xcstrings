          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua gorjeta está a aguardar aprovação. Será concluída assim que for aprovada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши чаевые ожидают подтверждения. Покупка завершится, как только её одобрят."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din dricks väntar på godkännande. Den genomförs så snart den har godkänts."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
