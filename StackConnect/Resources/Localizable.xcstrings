        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I report di Analytics sono in fase di generazione. Di solito ci vogliono 24-48 ore dopo la prima richiesta. Riprova più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analytics レポートを生成しています。通常、最初のリクエストから24～48時間かかります。後でもう一度ご確認ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분석 보고서를 생성하고 있습니다. 첫 요청 후 보통 24~48시간이 걸립니다. 나중에 다시 확인해 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analytics-rapporten worden gegenereerd. Dit duurt na het eerste verzoek meestal 24-48 uur. Kom later terug."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os relatórios de análises estão sendo gerados. Isso costuma levar de 24 a 48 horas após a primeira solicitação. Verifique novamente mais tarde."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os relatórios de análise estão a ser gerados. Normalmente demora 24 a 48 horas após o primeiro pedido. Volte a verificar mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отчеты аналитики создаются. Обычно это занимает 24–48 часов после первого запроса. Проверьте позже."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analysrapporter genereras. Det tar vanligtvis 24–48 timmar efter den första begäran. Kom tillbaka senare."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在產生分析報告。首次要求後通常需要 24 至 48 小時。請稍後再回來查看。"
          }
        }
      }
    },
