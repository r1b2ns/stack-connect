    "The Google Play service account key in this file is invalid. Ask the sender to export the account again." : {
      "comment" : "Error shown when an imported .scexport file carries a Google Play service account key that can't be parsed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Google-Play-Dienstkontoschlüssel in dieser Datei ist ungültig. Bitten Sie den Absender, das Konto erneut zu exportieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave de la cuenta de servicio de Google Play de este archivo no es válida. Pide al remitente que vuelva a exportar la cuenta."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave de la cuenta de servicio de Google Play de este archivo no es válida. Pídele al remitente que vuelva a exportar la cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé du compte de service Google Play de ce fichier n'est pas valide. Demandez à l'expéditeur d'exporter à nouveau le compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave dell'account di servizio Google Play in questo file non è valida. Chiedi al mittente di esportare di nuovo l'account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルの Google Play サービスアカウントキーは無効です。送信者にアカウントをもう一度書き出すよう依頼してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 파일의 Google Play 서비스 계정 키가 올바르지 않습니다. 보낸 사람에게 계정을 다시 내보내 달라고 요청하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Google Play-serviceaccountsleutel in dit bestand is ongeldig. Vraag de afzender om het account opnieuw te exporteren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave da conta de serviço do Google Play neste arquivo é inválida. Peça ao remetente para exportar a conta novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave da conta de serviço do Google Play neste ficheiro é inválida. Peça ao remetente para exportar novamente a conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ сервисного аккаунта Google Play в этом файле недействителен. Попросите отправителя экспортировать аккаунт ещё раз."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play-tjänstkontonyckeln i den här filen är ogiltig. Be avsändaren att exportera kontot igen."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檔案中的 Google Play 服務帳戶金鑰無效。請要求傳送者重新匯出帳戶。"
          }
        }
      }
    },
    "The Google sign-in for %@ expired or was revoked. Add the account again with Sign in with Google, using the same Google account, to restore access." : {
      "comment" : "Google sign-in error: one Google login expired. The argument is the Google account e-mail.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Google-Anmeldung für %@ ist abgelaufen oder wurde widerrufen. Füge das Konto erneut über „Mit Google anmelden“ mit demselben Google-Konto hinzu, um den Zugriff wiederherzustellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio de sesión de Google de %@ caducó o se revocó. Vuelve a añadir la cuenta con Iniciar sesión con Google, usando la misma cuenta de Google, para recuperar el acceso."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio de sesión de Google de %@ caducó o se revocó. Vuelve a agregar la cuenta con Iniciar sesión con Google, usando la misma cuenta de Google, para recuperar el acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion Google de %@ a expiré ou a été révoquée. Ajoutez de nouveau le compte avec Se connecter avec Google, en utilisant le même compte Google, pour rétablir l’accès."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso Google di %@ è scaduto o è stato revocato. Aggiungi di nuovo l’account con Accedi con Google, usando lo stesso account Google, per ripristinare l’accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の Google サインインの有効期限が切れたか、取り消されました。アクセスを復元するには、同じ Google アカウントを使って「Google でログイン」でアカウントを再度追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 Google 로그인이 만료되었거나 취소되었습니다. 접근 권한을 복원하려면 같은 Google 계정을 사용해 ‘Google 계정으로 로그인’으로 계정을 다시 추가하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Google-login voor %@ is verlopen of ingetrokken. Voeg het account opnieuw toe via ‘Inloggen met Google’ met hetzelfde Google-account om de toegang te herstellen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O login do Google de %@ expirou ou foi revogado. Adicione a conta de novo com Fazer login com o Google, usando a mesma conta do Google, para recuperar o acesso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sessão Google de %@ expirou ou foi revogada. Adicione a conta novamente com Iniciar sessão com o Google, usando a mesma conta Google, para recuperar o acesso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вход в Google для %@ истёк или был отозван. Чтобы восстановить доступ, снова добавьте аккаунт через «Войти через аккаунт Google», используя тот же аккаунт Google."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google-inloggningen för %@ har upphört eller återkallats. Lägg till kontot igen med ”Logga in med Google” och samma Google-konto för att återställa åtkomsten."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的 Google 登入已過期或遭撤銷。若要恢復存取權，請使用同一個 Google 帳戶，透過「使用 Google 帳戶登入」重新新增此帳戶。"
          }
        }
      }
    },
    "The Google sign-in for %@ expired or was revoked. Sign in again with the same Google account to keep using this account." : {
      "comment" : "Firebase screen of an account added with Sign in with Google, when its Google sign-in expired. The placeholder is the Google account's e-mail.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Google-Anmeldung für %@ ist abgelaufen oder wurde widerrufen. Melde dich erneut mit demselben Google-Konto an, um dieses Konto weiter zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio de sesión de Google de %@ caducó o se revocó. Vuelve a iniciar sesión con la misma cuenta de Google para seguir usando esta cuenta."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio de sesión de Google de %@ caducó o se revocó. Vuelve a iniciar sesión con la misma cuenta de Google para seguir usando esta cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion Google de %@ a expiré ou a été révoquée. Reconnectez-vous avec le même compte Google pour continuer à utiliser ce compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso Google di %@ è scaduto o è stato revocato. Accedi di nuovo con lo stesso account Google per continuare a usare questo account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の Google サインインの有効期限が切れたか、取り消されました。このアカウントを引き続き使用するには、同じ Google アカウントで再度サインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 Google 로그인이 만료되었거나 취소되었습니다. 이 계정을 계속 사용하려면 같은 Google 계정으로 다시 로그인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Google-login voor %@ is verlopen of ingetrokken. Log opnieuw in met hetzelfde Google-account om dit account te blijven gebruiken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O login do Google de %@ expirou ou foi revogado. Faça login de novo com a mesma conta do Google para continuar usando esta conta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sessão Google de %@ expirou ou foi revogada. Inicie sessão novamente com a mesma conta Google para continuar a usar esta conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вход в Google для %@ истёк или был отозван. Войдите снова с тем же аккаунтом Google, чтобы продолжить пользоваться этим аккаунтом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google-inloggningen för %@ har upphört eller återkallats. Logga in igen med samma Google-konto för att fortsätta använda kontot."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的 Google 登入已過期或遭撤銷。請使用同一個 Google 帳戶重新登入，以繼續使用此帳戶。"
          }
        }
      }
    },
