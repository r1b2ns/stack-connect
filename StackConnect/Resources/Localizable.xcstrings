    "Development and Ad Hoc profiles must include at least one device." : {
      "comment" : "A footer message in the \"Pick devices\" section of the \"Create Profile\" view, reminding them that development and ad hoc profiles must include at least one device.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
