          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" richiede un nuovo accesso"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」には再度サインインが必要です"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\"에 다시 로그인해야 합니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" vereist dat je opnieuw inlogt"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" precisa que você faça login de novo"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" precisa que inicie sessão novamente"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@»: нужно войти снова"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” kräver att du loggar in igen"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」需要你重新登入"
          }
        }
      }
    },
    "“View app information” is always included with any other permission. Permissions the user already has for all apps are shown on and can't be turned off here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„App-Informationen ansehen“ ist bei jeder anderen Berechtigung immer enthalten. Berechtigungen, die der Nutzer schon für alle Apps hat, werden aktiviert angezeigt und können hier nicht deaktiviert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ver información de la app» siempre se incluye con cualquier otro permiso. Los permisos que el usuario ya tiene para todas las apps aparecen activados y no se pueden desactivar aquí."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Ver información de la app» siempre se incluye con cualquier otro permiso. Los permisos que el usuario ya tiene para todas las apps aparecen activados y no se pueden desactivar aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Voir les informations sur l'app » est toujours inclus avec toute autre autorisation. Les autorisations que l'utilisateur a déjà pour toutes les apps sont affichées activées et ne peuvent pas être désactivées ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Visualizzare le informazioni dell'app” è sempre incluso con qualsiasi altro permesso. I permessi che l'utente ha già per tutte le app sono mostrati attivi e qui non si possono disattivare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「アプリ情報の表示」は他の権限に常に含まれます。ユーザーがすでにすべてのアプリで持っている権限はオンで表示され、ここではオフにできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'앱 정보 보기'는 다른 권한에 항상 포함됩니다. 사용자가 이미 모든 앱에 대해 가진 권한은 켜진 상태로 표시되며 여기서 끌 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘App-informatie bekijken’ zit altijd bij elk ander recht. Rechten die de gebruiker al voor alle apps heeft, staan aan en kunnen hier niet worden uitgezet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ver informações do app” sempre acompanha qualquer outra permissão. As permissões que o usuário já tem para todos os apps aparecem ativadas e não podem ser desativadas aqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ver informações do app” sempre acompanha qualquer outra permissão. As permissões que o usuário já tem para todos os apps aparecem ativadas e não podem ser desativadas aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Просмотр информации о приложении» всегда входит в любое другое разрешение. Разрешения, которые у пользователя уже есть для всех приложений, показаны включёнными и здесь не отключаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Visa appinformation” ingår alltid med alla andra behörigheter. Behörigheter som användaren redan har för alla appar visas som påslagna och kan inte stängas av här."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「檢視 App 資訊」一律包含在其他任何權限中。使用者已對所有 App 擁有的權限會顯示為開啟，且無法在此關閉。"
          }
        }
      }
    },
