      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google teilt StackConnect nicht mit, welches Entwicklerkonto verwendet werden soll: Die ID findest du in der Play Console › Einstellungen › Entwicklerkonto (und in jeder Play Console-URL). Das Google-Konto %@ benötigt die Berechtigung „Administrator (alle Berechtigungen)“, um Nutzer zu verwalten."
          }
        },
