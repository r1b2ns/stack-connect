          }
        }
      }
    },
    "StackConnect connects this device straight to %@, using only the access you give it." : {
      "comment" : "Connection guide, page 1. The placeholder is the service being connected, e.g. App Store Connect.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect verbindet dieses Gerät direkt mit %@ und nutzt dabei nur den Zugriff, den du erteilst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect connects this device straight to %@, using only the access you give it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect conecta este dispositivo directamente con %@, usando solo el acceso que tú le das."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect conecta este dispositivo directamente con %@, usando solo el acceso que tú le das."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect relie cet appareil directement à %@, en utilisant uniquement l’accès que vous lui accordez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect collega direttamente questo dispositivo con %@, usando solo l’accesso che gli concedi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect はこのデバイスを %@ に直接接続し、あなたが許可したアクセスだけを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect는 이 기기를 %@에 직접 연결하며, 사용자가 허용한 접근 권한만 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect verbindt dit apparaat rechtstreeks met %@ en gebruikt alleen de toegang die jij geeft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O StackConnect conecta este dispositivo diretamente ao %@, usando só o acesso que você concede."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O StackConnect liga este dispositivo diretamente ao %@, usando apenas o acesso que concede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect подключает это устройство напрямую к %@, используя только тот доступ, который вы предоставили."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect ansluter den här enheten direkt till %@ och använder bara den åtkomst du ger."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect 會讓此裝置直接連線到 %@，只使用你授予的存取權限。"
          }
        }
      }
    },
