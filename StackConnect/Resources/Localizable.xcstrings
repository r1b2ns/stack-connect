    "Your support means a lot and helps keep StackConnect going." : {
      "comment" : "Message of the sheet shown after a tip purchase succeeds.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Unterstützung bedeutet sehr viel und hilft, StackConnect am Laufen zu halten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu apoyo significa mucho y ayuda a que StackConnect siga adelante."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu apoyo significa mucho y ayuda a que StackConnect siga adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre soutien compte énormément et aide StackConnect à continuer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo supporto conta molto e aiuta StackConnect ad andare avanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのご支援はとても励みになり、StackConnect の継続に役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러분의 후원은 큰 힘이 되며 StackConnect를 이어가는 데 도움이 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je steun betekent veel en helpt StackConnect draaiende te houden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu apoio significa muito e ajuda a manter o StackConnect funcionando."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu apoio significa muito e ajuda a manter o StackConnect a funcionar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша поддержка очень важна и помогает развивать StackConnect."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt stöd betyder mycket och hjälper till att hålla StackConnect igång."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的支持意義重大，也讓 StackConnect 能持續發展。"
          }
        }
      }
    },
    "Your team's Account Holder must accept the latest Apple Developer Program License Agreement in App Store Connect before these resources are available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Account-Inhaber deines Teams muss das neueste Apple Developer Program License Agreement in App Store Connect akzeptieren, bevor diese Ressourcen verfügbar sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El titular de la cuenta de tu equipo debe aceptar el último Acuerdo de licencia del Apple Developer Program en App Store Connect para que estos recursos estén disponibles."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Titular de la cuenta de tu equipo debe aceptar el Acuerdo de licencia del Apple Developer Program más reciente en App Store Connect para que estos recursos estén disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le titulaire du compte de votre équipe doit accepter le dernier contrat de licence du programme Apple Developer dans App Store Connect pour que ces ressources soient disponibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il titolare dell'account del tuo team deve accettare l'ultimo Contratto di licenza dell'Apple Developer Program in App Store Connect prima che queste risorse siano disponibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのリソースを利用するには、チームのアカウント所有者が App Store Connect で最新の Apple Developer Program 使用許諾契約に同意する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 리소스를 사용하려면 팀의 계정 소유자가 App Store Connect에서 최신 Apple Developer Program 사용권 계약에 동의해야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De accounthouder van je team moet de nieuwste Apple Developer Program License Agreement accepteren in App Store Connect voordat deze bronnen beschikbaar zijn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Titular da conta da sua equipe precisa aceitar o Contrato de Licença do Apple Developer Program mais recente no App Store Connect antes que esses recursos fiquem disponíveis."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O titular da conta da sua equipa tem de aceitar o Contrato de Licença do Apple Developer Program mais recente no App Store Connect para que estes recursos fiquem disponíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Владелец аккаунта вашей команды должен принять последнюю версию Apple Developer Program License Agreement в App Store Connect, прежде чем эти ресурсы станут доступны."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt teams kontoinnehavare måste godkänna det senaste licensavtalet för Apple Developer Program i App Store Connect innan dessa resurser blir tillgängliga."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你團隊的帳號持有人必須先在 App Store Connect 中接受最新的 Apple Developer Program 授權合約，才能使用這些資源。"
          }
        }
      }
    },
    "Your tip is waiting for approval. It will go through once it's approved." : {
      "comment" : "Message of the banner shown when a tip is waiting for approval (Ask to Buy).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Trinkgeld wartet auf Genehmigung. Es wird abgeschlossen, sobald es genehmigt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu propina está pendiente de aprobación. Se completará en cuanto se apruebe."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu propina está pendiente de aprobación. Se completará en cuanto se apruebe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre pourboire est en attente d’approbation. Il sera finalisé dès qu’il aura été approuvé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua mancia è in attesa di approvazione. Verrà completata non appena sarà approvata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チップは承認待ちです。承認されると完了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "팁이 승인을 기다리고 있습니다. 승인되면 완료됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je fooi wacht op goedkeuring. Deze wordt afgerond zodra hij is goedgekeurd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
