        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш вход в Google истёк или был отозван. Войдите снова с тем же аккаунтом Google, чтобы продолжить пользоваться этим аккаунтом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Google-inloggning har upphört eller återkallats. Logga in igen med samma Google-konto för att fortsätta använda kontot."
          }
