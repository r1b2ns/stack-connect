    "Google Play only shares reviews with a comment from the last 7 days." : {
      "comment" : "Home Recent Reviews footnote when Google Play reviews are listed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play gibt nur Rezensionen mit Kommentar aus den letzten 7 Tagen weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play solo comparte reseñas con comentario de los últimos 7 días."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play solo comparte reseñas con comentario de los últimos 7 días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play ne partage que les avis avec commentaire des 7 derniers jours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play condivide solo le recensioni con un commento degli ultimi 7 giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play が共有するのは、過去 7 日間のコメント付きレビューのみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play는 최근 7일 이내의 댓글이 있는 리뷰만 공유합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play deelt alleen recensies met een opmerking van de afgelopen 7 dagen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Google Play só compartilha avaliações com comentário dos últimos 7 dias."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Google Play só partilha avaliações com comentário dos últimos 7 dias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play передает только отзывы с комментарием за последние 7 дней."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play delar bara recensioner med en kommentar från de senaste 7 dagarna."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play 只會分享過去 7 天內附有評論的評價。"
          }
        }
      }
    },
    "Google Play only shares reviews with a comment that were written or edited in the last 7 days. Older reviews are available in Play Console." : {
      "comment" : "Note under the Google Play review list explaining the limits of Google's review API.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play gibt nur Rezensionen mit Kommentar weiter, die in den letzten 7 Tagen geschrieben oder bearbeitet wurden. Ältere Rezensionen finden Sie in der Play Console."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play solo comparte las reseñas con comentario escritas o editadas en los últimos 7 días. Las reseñas más antiguas están disponibles en Play Console."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play solo comparte las reseñas con comentario escritas o editadas en los últimos 7 días. Las reseñas más antiguas están disponibles en Play Console."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play ne partage que les avis avec commentaire rédigés ou modifiés au cours des 7 derniers jours. Les avis plus anciens sont disponibles dans Play Console."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play condivide solo le recensioni con commento scritte o modificate negli ultimi 7 giorni. Le recensioni meno recenti sono disponibili in Play Console."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play で共有されるのは、過去 7 日間に投稿または編集されたコメント付きのレビューのみです。それより前のレビューは Play Console で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play에서는 최근 7일 이내에 작성되거나 수정된 댓글이 있는 리뷰만 공유합니다. 이전 리뷰는 Play Console에서 확인할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play deelt alleen recensies met een opmerking die in de afgelopen 7 dagen zijn geschreven of bewerkt. Oudere recensies vind je in Play Console."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Google Play só compartilha avaliações com comentário escritas ou editadas nos últimos 7 dias. As avaliações mais antigas estão disponíveis no Play Console."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Google Play só partilha avaliações com comentário escritas ou editadas nos últimos 7 dias. As avaliações mais antigas estão disponíveis na Play Console."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play передает только отзывы с комментарием, написанные или измененные за последние 7 дней. Более ранние отзывы доступны в Play Console."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play delar bara recensioner med en kommentar som har skrivits eller redigerats under de senaste 7 dagarna. Äldre recensioner finns i Play Console."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play 只會分享過去 7 天內撰寫或編輯過且附有評論的評論。較舊的評論可在 Play Console 中查看。"
          }
        }
      }
    },
    "Google Play refused access to this developer account. Check the Developer ID, and that the Google account %@ has the “Admin (all permissions)” permission." : {
      "comment" : "Google Play users screen, account added with Sign in with Google. The placeholder is that Google account's e-mail.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play hat den Zugriff auf dieses Entwicklerkonto verweigert. Prüfe die Entwickler-ID und ob das Google-Konto %@ die Berechtigung „Administrator (alle Berechtigungen)“ hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play rechazó el acceso a esta cuenta de desarrollador. Comprueba el ID de desarrollador y que la cuenta de Google %@ tenga el permiso “Administrador (todos los permisos)”."
          }
        },
        "es-MX" : {
          "stringUnit" : {
