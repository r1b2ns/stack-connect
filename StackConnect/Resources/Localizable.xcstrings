    "Google Play requires these changes to be saved without sending them for review. Turn off “Send changes for review” and try again." : {
      "comment" : "Error when Google Play refuses a commit that was sent for review but must not be.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play verlangt, dass diese Änderungen gespeichert werden, ohne sie zur Überprüfung zu senden. Deaktiviere „Änderungen zur Überprüfung senden“ und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play exige guardar estos cambios sin enviarlos a revisión. Desactiva «Enviar cambios a revisión» e inténtalo de nuevo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play exige guardar estos cambios sin enviarlos a revisión. Desactiva «Enviar cambios a revisión» e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play exige que ces modifications soient enregistrées sans être envoyées pour examen. Désactivez « Envoyer les modifications pour examen » et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play richiede che queste modifiche vengano salvate senza inviarle per la revisione. Disattiva “Invia le modifiche per la revisione” e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play では、これらの変更を審査に送信せずに保存する必要があります。「変更を審査に送信」をオフにしてもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play에서는 이 변경 사항을 검토에 보내지 않고 저장해야 합니다. ‘변경 사항을 검토에 보내기’를 끄고 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play vereist dat deze wijzigingen worden opgeslagen zonder ze ter beoordeling te sturen. Zet ‘Wijzigingen ter beoordeling sturen’ uit en probeer het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Google Play exige que essas alterações sejam salvas sem enviá-las para revisão. Desative “Enviar alterações para revisão” e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Google Play exige que estas alterações sejam guardadas sem as enviar para revisão. Desative “Enviar alterações para revisão” e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play требует сохранить эти изменения без отправки на проверку. Выключите «Отправить изменения на проверку» и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play kräver att ändringarna sparas utan att skickas för granskning. Stäng av ”Skicka ändringar för granskning” och försök igen."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play 要求儲存這些變更但不送交審查。請關閉「將變更送交審查」後再試一次。"
          }
        }
      }
    },
