    "Pending invitations can't be edited. Cancel and re-invite to change roles." : {
      "comment" : "Footer explaining that pending invitations cannot be edited.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausstehende Einladungen können nicht bearbeitet werden. Ziehe sie zurück und lade erneut ein, um Rollen zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las invitaciones pendientes no se pueden editar. Cancela y vuelve a invitar para cambiar los roles."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las invitaciones pendientes no se pueden editar. Cancela y vuelve a invitar para cambiar los roles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les invitations en attente ne peuvent pas être modifiées. Annulez-les et invitez à nouveau pour changer les rôles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli inviti in sospeso non possono essere modificati. Annulla e invita di nuovo per cambiare i ruoli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留中の招待は編集できません。ロールを変更するには、キャンセルして再度招待してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대기 중인 초대는 편집할 수 없습니다. 역할을 변경하려면 취소한 후 다시 초대하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Openstaande uitnodigingen kunnen niet worden gewijzigd. Annuleer en nodig opnieuw uit om rollen te wijzigen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convites pendentes não podem ser editados. Cancele e convide novamente para alterar as funções."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
