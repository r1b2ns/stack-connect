      }
    },
    "This JSON isn't a service account key. In Google Cloud, open IAM & Admin › Service Accounts, pick the account and create a JSON key under Keys." : {
      "comment" : "Error shown when the pasted JSON is not a Google service account key (e.g. an OAuth client file).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses JSON ist kein Dienstkontoschlüssel. Öffnen Sie in Google Cloud „IAM & Verwaltung › Dienstkonten“, wählen Sie das Konto aus und erstellen Sie unter „Schlüssel“ einen JSON-Schlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este JSON no es una clave de cuenta de servicio. En Google Cloud, abre IAM y administración › Cuentas de servicio, elige la cuenta y crea una clave JSON en Claves."
