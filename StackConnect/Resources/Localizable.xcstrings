    "Halting stops new users from getting this release. Users who already updated keep it. You can resume later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch das Anhalten erhalten neue Nutzer dieses Release nicht mehr. Wer bereits aktualisiert hat, behält es. Du kannst später fortsetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al detenerlo, los usuarios nuevos dejan de recibir esta versión. Quienes ya actualizaron la conservan. Puedes reanudarlo más tarde."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al detenerlo, los usuarios nuevos dejan de recibir esta versión. Quienes ya actualizaron la conservan. Puedes reanudarlo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’interruption empêche les nouveaux utilisateurs de recevoir cette version. Ceux qui ont déjà mis à jour la conservent. Vous pourrez reprendre plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrompendo, i nuovi utenti non ricevono più questa release. Chi ha già aggiornato la mantiene. Puoi riprendere in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止すると、新しいユーザーにはこのリリースが配信されなくなります。すでにアップデートしたユーザーはそのまま使えます。後で再開できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중단하면 새 사용자는 이 출시 버전을 받지 않습니다. 이미 업데이트한 사용자는 그대로 유지됩니다. 나중에 재개할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Door te stoppen krijgen nieuwe gebruikers deze release niet meer. Wie al heeft geüpdatet, houdt hem. Je kunt later hervatten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interromper impede que novos usuários recebam esta versão. Quem já atualizou mantém a versão. Você pode retomar depois."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interromper impede que novos utilizadores recebam esta versão. Quem já atualizou mantém a versão. Pode retomar mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После остановки новые пользователи не будут получать этот выпуск. Те, кто уже обновился, сохранят его. Развёртывание можно возобновить позже."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du pausar får nya användare inte längre versionen. De som redan har uppdaterat behåller den. Du kan återuppta senare."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暫停後，新使用者將不會取得此版本，已更新的使用者會保留它。你之後可以繼續推出。"
          }
        }
      }
    },
