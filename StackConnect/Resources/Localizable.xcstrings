    "Version code %@ isn't higher than %@, already live on %@." : {
      "comment" : "Google Play new release guard. Arguments: chosen version code, live version code, track name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versionscode %1$@ ist nicht höher als %2$@, der bereits auf %3$@ live ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El código de versión %1$@ no es mayor que %2$@, ya publicado en %3$@."
