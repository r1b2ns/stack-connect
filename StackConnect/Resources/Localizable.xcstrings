        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В следующий раз понадобится только код проверки. Хранится в связке ключей этого устройства."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
