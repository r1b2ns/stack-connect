    "Tap \"Download API Key\" — this is the only time you can download it. Use \"Import .p8 file\" above to load it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „Download API Key“ – das ist die einzige Gelegenheit, ihn herunterzuladen. Verwende oben „Import .p8 file“, um ihn zu laden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca \"Download API Key\": es la única vez que puedes descargarlo. Usa \"Import .p8 file\" arriba para cargarlo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca \"Download API Key\": es la única vez que puedes descargarlo. Usa \"Import .p8 file\" arriba para cargarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez « Download API Key » — c'est la seule fois où vous pouvez le télécharger. Utilisez « Import .p8 file » ci-dessus pour le charger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca \"Download API Key\": è l'unica volta in cui puoi scaricarlo. Usa \"Import .p8 file\" qui sopra per caricarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Download API Key」をタップします。ダウンロードできるのはこの時だけです。上の「Import .p8 file」を使って読み込んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Download API Key\"를 탭하세요. 다운로드할 수 있는 것은 이번 한 번뿐입니다. 위의 \"Import .p8 file\"을 사용해 불러오세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op \"Download API Key\" — dit is de enige keer dat je deze kunt downloaden. Gebruik hierboven \"Import .p8 file\" om deze te laden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em \"Download API Key\" — esta é a única vez que você pode baixá-la. Use \"Import .p8 file\" acima para carregá-la."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
