        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impressões, visualizações da página do produto e como os usuários encontram e interagem com seu app na App Store."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
