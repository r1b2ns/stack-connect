        }
      }
    },
    "In play.google.com/console, go to Users and permissions, invite the service account e-mail and grant at least \"View app information (read-only)\"." : {
      "comment" : "Google Play setup tutorial step detail.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie in play.google.com/console „Nutzer und Berechtigungen“, laden Sie die E-Mail-Adresse des Dienstkontos ein und gewähren Sie mindestens „App-Informationen ansehen (Lesezugriff)“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En play.google.com/console, ve a Usuarios y permisos, invita el correo de la cuenta de servicio y concede al menos «Ver información de la aplicación (solo lectura)»."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En play.google.com/console, ve a Usuarios y permisos, invita el correo de la cuenta de servicio y otorga al menos \"Ver información de la app (solo lectura)\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans play.google.com/console, accédez à Utilisateurs et autorisations, invitez l'adresse e-mail du compte de service et accordez au moins « Afficher les informations sur l'application (lecture seule) »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In play.google.com/console, vai a Utenti e autorizzazioni, invita l'e-mail dell'account di servizio e concedi almeno “Visualizza informazioni sull'app (sola lettura)”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "play.google.com/console で「ユーザーと権限」に進み、サービスアカウントのメールアドレスを招待して、少なくとも「アプリ情報の閲覧（読み取り専用）」を付与します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "play.google.com/console에서 사용자 및 권한으로 이동해 서비스 계정 이메일을 초대하고 최소한 “앱 정보 보기(읽기 전용)” 권한을 부여합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ga in play.google.com/console naar Gebruikers en rechten, nodig het e-mailadres van het serviceaccount uit en geef minimaal ‘App-informatie bekijken (alleen-lezen)’."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em play.google.com/console, vá em Usuários e permissões, convide o e-mail da conta de serviço e conceda, no mínimo, \"Ver informações do app (somente leitura)\"."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em play.google.com/console, aceda a Utilizadores e autorizações, convide o e-mail da conta de serviço e conceda, pelo menos, \"Ver informações da app (só de leitura)\"."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В play.google.com/console откройте «Пользователи и разрешения», пригласите адрес эл. почты сервисного аккаунта и предоставьте как минимум право «Просмотр информации о приложении (только чтение)»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå till Användare och behörigheter i play.google.com/console, bjud in tjänstkontots e-postadress och ge minst ”Visa appinformation (skrivskyddad)”."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 play.google.com/console 前往「使用者和權限」，邀請服務帳戶的電子郵件，並至少授予「查看應用程式資訊 (唯讀)」權限。"
          }
        }
      }
    },
