    "The copy stays on this device, never reaches your Mac or iPad, and is cleared from the clipboard in 2 minutes." : {
      "comment" : "Network audit export: clipboard note when a token is included.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopie bleibt auf diesem Gerät, erreicht nie deinen Mac oder dein iPad und wird nach 2 Minuten aus der Zwischenablage gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia se queda en este dispositivo, nunca llega a tu Mac o iPad y se borra del portapapeles en 2 minutos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia se queda en este dispositivo, nunca llega a tu Mac ni a tu iPad y se borra del portapapeles en 2 minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie reste sur cet appareil, n’atteint jamais votre Mac ou votre iPad, et est effacée du presse-papiers au bout de 2 minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia resta su questo dispositivo, non arriva mai al tuo Mac o iPad e viene cancellata dagli appunti dopo 2 minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーはこのデバイスにとどまり、Mac や iPad には送られず、2分後にクリップボードから消去されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복사본은 이 기기에만 남고 Mac이나 iPad로 전달되지 않으며, 2분 후 클립보드에서 지워집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kopie blijft op dit apparaat, bereikt nooit je Mac of iPad en wordt na 2 minuten van het klembord gewist."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cópia fica só neste aparelho, sem ir para o Mac ou o iPad, e é apagada da área de transferência em 2 minutos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cópia fica neste dispositivo, nunca chega ao seu Mac ou iPad e é apagada da área de transferência após 2 minutos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копия остаётся на этом устройстве, никогда не попадает на ваш Mac или iPad и удаляется из буфера обмена через 2 минуты."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopian stannar på den här enheten, når aldrig din Mac eller iPad och rensas från urklipp efter 2 minuter."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拷貝的內容會保留在此裝置上，絕不會傳到你的 Mac 或 iPad，並會在 2 分鐘後從剪貼板清除。"
          }
        }
      }
    },
    "The credentials of this account are missing on this device. Remove the account and add it again." : {
      "comment" : "Account status notice: no Keychain credentials for the account.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zugangsdaten dieses Accounts fehlen auf diesem Gerät. Entferne den Account und füge ihn erneut hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faltan las credenciales de esta cuenta en este dispositivo. Elimina la cuenta y vuelve a añadirla."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faltan las credenciales de esta cuenta en este dispositivo. Elimina la cuenta y vuelve a agregarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les identifiants de ce compte sont absents de cet appareil. Supprimez le compte et ajoutez-le à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le credenziali di questo account mancano su questo dispositivo. Rimuovi l'account e aggiungilo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスにこのアカウントの認証情報がありません。アカウントを削除して、もう一度追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에 이 계정의 자격 증명이 없습니다. 계정을 삭제하고 다시 추가하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
