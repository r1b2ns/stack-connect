    },
    "This is the service account StackConnect uses for this account. Removing it, or its Admin permission, would lock StackConnect out of this developer account. Make the change in Play Console if you really need to." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist das Dienstkonto, das StackConnect für dieses Konto nutzt. Es oder seine Administratorberechtigung zu entfernen, würde StackConnect aus diesem Entwicklerkonto aussperren. Nimm die Änderung bei Bedarf in der Play Console vor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta es la cuenta de servicio que StackConnect usa para esta cuenta. Eliminarla, o quitarle el permiso de administrador, dejaría a StackConnect sin acceso a esta cuenta de desarrollador. Si de verdad lo necesitas, hazlo en Play Console."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
