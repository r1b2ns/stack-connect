    "Hi %@, the App Store Connect team \"%@\" has pending agreements. As Account Holder, please review and accept them: %@" : {
      "comment" : "Share message asking a named App Store Connect Account Holder to accept pending agreements. Arguments: Account Holder name, team name, agreements URL.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo %1$@, das App Store Connect-Team „%2$@“ hat ausstehende Vereinbarungen. Als Account-Inhaber prüfe und akzeptiere sie bitte: %3$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hi %1$@, the App Store Connect team \"%2$@\" has pending agreements. As Account Holder, please review and accept them: %3$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola, %1$@: el equipo de App Store Connect «%2$@» tiene acuerdos pendientes. Como titular de la cuenta, revísalos y acéptalos: %3$@"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola, %1$@: el equipo de App Store Connect \"%2$@\" tiene acuerdos pendientes. Como titular de la cuenta, revísalos y acéptalos: %3$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour %1$@, l’équipe App Store Connect « %2$@ » a des accords en attente. En tant que titulaire du compte, merci de les examiner et de les accepter : %3$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao %1$@, il team App Store Connect “%2$@” ha contratti in sospeso. In qualità di titolare dell'account, esaminali e accettali: %3$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ さん、App Store Connect チーム「%2$@」に未承認の契約があります。アカウント所有者として、確認して同意してください: %3$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@님, App Store Connect 팀 “%2$@”에 보류 중인 계약이 있습니다. 계정 소유자로서 검토하고 동의해 주세요: %3$@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoi %1$@, het App Store Connect-team ‘%2$@’ heeft openstaande overeenkomsten. Bekijk en accepteer ze als accounthouder: %3$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olá, %1$@! A equipe \"%2$@\" do App Store Connect tem contratos pendentes. Como Titular da conta, revise e aceite-os: %3$@"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olá, %1$@! A equipa \"%2$@\" do App Store Connect tem contratos pendentes. Como titular da conta, reveja e aceite-os: %3$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здравствуйте, %1$@! У команды App Store Connect «%2$@» есть непринятые соглашения. Как владелец аккаунта, просмотрите и примите их: %3$@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hej %1$@! App Store Connect-teamet ”%2$@” har väntande avtal. Som kontoinnehavare behöver du granska och godkänna dem: %3$@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 您好，App Store Connect 團隊「%2$@」有待處理的協議。身為帳號持有人，請檢閱並接受：%3$@"
          }
        }
      }
    },
    "Hi, the App Store Connect team \"%@\" has pending agreements that must be accepted by its Account Holder: %@" : {
