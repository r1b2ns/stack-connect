    "Google Play's API quota for this account was reached. Wait a few minutes and try again." : {
      "comment" : "Error shown when Google Play answers with an API quota or rate limit (the core reports it as HTTP 429).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Google Play API-Kontingent dieses Kontos wurde erreicht. Warten Sie einige Minuten und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha alcanzado la cuota de la API de Google Play de esta cuenta. Espera unos minutos e inténtalo de nuevo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se alcanzó la cuota de la API de Google Play de esta cuenta. Espera unos minutos e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
