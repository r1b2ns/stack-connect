          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As campanhas enviadas a partir do StackConnect aparecem aqui. O Firebase não disponibiliza uma API pública para listar as campanhas criadas na consola."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
