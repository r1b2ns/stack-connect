        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ にリクエストしました。通常の 24〜48 時間より時間がかかっています。一部のレポートタイプはすべての App で生成されるわけではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 요청함. 일반적인 24~48시간보다 오래 걸리고 있습니다. 일부 보고서 유형은 모든 앱에서 생성되지는 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aangevraagd op %@. Dit duurt langer dan de gebruikelijke 24–48 uur — sommige rapporttypen worden niet voor elke app gemaakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitado %@. Está demorando mais do que as 24–48 horas habituais — alguns tipos de relatório não são gerados para todos os apps."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
