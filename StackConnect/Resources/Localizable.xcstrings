    },
    "Each team is added as its own account. They share this sign-in: when it expires, you sign in once for all of them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Team wird als eigener Account hinzugefügt. Sie teilen sich diese Anmeldung: Läuft sie ab, meldest du dich einmal für alle an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada equipo se añade como una cuenta propia. Comparten este inicio de sesión: cuando caduque, inicias sesión una sola vez para todos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada equipo se agrega como una cuenta propia. Comparten este inicio de sesión: cuando expire, inicias sesión una sola vez para todos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque équipe est ajoutée comme un compte distinct. Elles partagent cette connexion : quand elle expire, vous vous reconnectez une seule fois pour toutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni team viene aggiunto come account separato. Condividono questo accesso: quando scade, accedi una volta sola per tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チームはそれぞれ個別のアカウントとして追加されます。このサインインは共有されるため、有効期限が切れても一度サインインすればすべてに反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 팀은 별도의 계정으로 추가됩니다. 이 로그인은 공유되므로 만료되면 한 번만 로그인하면 모두에 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk team wordt als eigen account toegevoegd. Ze delen deze login: verloopt hij, dan log je één keer in voor allemaal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada equipe é adicionada como uma conta própria. Elas compartilham este login: quando ele expirar, você faz login uma vez para todas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada equipa é adicionada como uma conta própria. Partilham este início de sessão: quando expirar, inicia sessão uma vez para todas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая команда добавляется как отдельная учетная запись. У них общий вход: когда он истечет, войдите один раз для всех."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje team läggs till som ett eget konto. De delar den här inloggningen: när den går ut loggar du in en gång för alla."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個團隊都會加入為獨立帳號。它們共用此登入：過期時，只要登入一次即可套用到全部。"
          }
        }
      }
    },
