    "“%@” expired. Import a new file of this account and its password." : {
      "comment" : "Account wizard: re-importing an expired shared account. The placeholder is the account name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist abgelaufen. Importiere eine neue Datei dieses Accounts und ihr Passwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» ha caducado. Importa un archivo nuevo de esta cuenta y su contraseña."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” caducó. Importa un nuevo archivo de esta cuenta y su contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » a expiré. Importez un nouveau fichier de ce compte et son mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” è scaduto. Importa un nuovo file di questo account e la relativa password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の有効期限が切れました。このアカウントの新しいファイルとそのパスワードをインポートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”이(가) 만료되었습니다. 이 계정의 새 파일과 해당 비밀번호를 가져오세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ is verlopen. Importeer een nieuw bestand van dit account en het bijbehorende wachtwoord."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” expirou. Importe um novo arquivo desta conta e a senha dele."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” expirou. Importe um novo ficheiro desta conta e a respetiva palavra-passe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срок «%@» истёк. Импортируйте новый файл этого аккаунта и его пароль."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” har upphört. Importera en ny fil för kontot och dess lösenord."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」已過期。請匯入此帳號的新檔案及其密碼。"
          }
        }
      }
    },
    "\"%@\" needs you to sign in again" : {
      "comment" : "Home banner title when one account's sign-in (Apple ID or Google) expired. The placeholder is the account name.",
      "localizations" : {
        "de" : {
