    "Impressions, product page views, and how users find and engage with your app on the App Store." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impressionen, Produktseitenaufrufe und wie Nutzer deine App im App Store finden und mit ihr interagieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
