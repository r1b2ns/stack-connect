    "Events are deleted permanently. New ones keep being recorded." : {
      "comment" : "Network audit: Delete All confirmation message.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ereignisse werden endgültig gelöscht. Neue werden weiterhin aufgezeichnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los eventos se eliminan de forma permanente. Los nuevos se siguen registrando."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los eventos se eliminan de forma permanente. Los nuevos se siguen registrando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les événements sont supprimés définitivement. Les nouveaux continuent d’être enregistrés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli eventi vengono eliminati definitivamente. I nuovi continuano a essere registrati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イベントは完全に削除されます。新しいイベントは引き続き記録されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이벤트가 영구적으로 삭제됩니다. 새 이벤트는 계속 기록됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebeurtenissen worden permanent verwijderd. Nieuwe worden gewoon vastgelegd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga os eventos de forma permanente. Os novos continuam sendo registrados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os eventos são eliminados permanentemente. Os novos continuam a ser registados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "События удаляются безвозвратно. Новые продолжат записываться."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Händelser raderas permanent. Nya fortsätter att registreras."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "事件會永久刪除。新的事件仍會持續記錄。"
          }
        }
      }
    },
    "Events older than the chosen period are deleted automatically, every day and whenever the app opens." : {
      "comment" : "Network audit: retention section footer.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ereignisse, die älter als der gewählte Zeitraum sind, werden automatisch gelöscht – täglich und bei jedem Öffnen der App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los eventos más antiguos que el periodo elegido se eliminan automáticamente, cada día y cada vez que se abre la app."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los eventos anteriores al período elegido se eliminan automáticamente, cada día y cada vez que se abre la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les événements plus anciens que la période choisie sont supprimés automatiquement, chaque jour et à chaque ouverture de l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli eventi più vecchi del periodo scelto vengono eliminati automaticamente, ogni giorno e a ogni apertura dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した期間より古いイベントは、毎日および App を開くたびに自動的に削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 기간보다 오래된 이벤트는 매일, 그리고 앱을 열 때마다 자동으로 삭제됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebeurtenissen ouder dan de gekozen periode worden automatisch verwijderd, elke dag en telkens wanneer de app wordt geopend."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventos mais antigos que o período escolhido são apagados automaticamente, todo dia e sempre que o app abre."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os eventos mais antigos do que o período escolhido são eliminados automaticamente, todos os dias e sempre que a app é aberta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "События старше выбранного периода удаляются автоматически — ежедневно и при каждом открытии приложения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Händelser som är äldre än den valda perioden raderas automatiskt, varje dag och när appen öppnas."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超過所選期間的事件會在每天及每次打開 App 時自動刪除。"
          }
        }
      }
    },
    "Every app of this account already has access set for this user." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für jede App dieses Kontos ist der Zugriff dieses Nutzers bereits festgelegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las apps de esta cuenta ya tienen acceso configurado para este usuario."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las apps de esta cuenta ya tienen acceso configurado para este usuario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les apps de ce compte ont déjà un accès défini pour cet utilisateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le app di questo account hanno già un accesso impostato per questo utente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアカウントのすべてのアプリで、このユーザーのアクセスはすでに設定されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 계정의 모든 앱에 이 사용자의 액세스가 이미 설정되어 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor elke app van dit account is de toegang van deze gebruiker al ingesteld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os apps desta conta já têm acesso definido para este usuário."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os apps desta conta já têm acesso definido para este usuário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для всех приложений этого аккаунта доступ этого пользователя уже настроен."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla appar i det här kontot har redan åtkomst inställd för den här användaren."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此帳號的每個 App 都已為此使用者設定存取權。"
          }
        }
      }
    },
    "Every destination the app contacted shows up here, telemetry and remote configuration included. Nothing is left out." : {
      "comment" : "Network audit: Destinations footer.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Ziel, das die App kontaktiert hat, erscheint hier, einschließlich Telemetrie und Remote-Konfiguration. Nichts wird ausgelassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparece cada destino al que se conectó la app, incluidas la telemetría y la configuración remota. No se omite nada."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparece cada destino que contactó la app, incluidas la telemetría y la configuración remota. No se omite nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque destination contactée par l’app apparaît ici, télémétrie et configuration à distance comprises. Rien n’est omis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui compare ogni destinazione contattata dall'app, comprese telemetria e configurazione remota. Non viene escluso nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App が接続したすべての接続先がここに表示されます。テレメトリやリモート構成も含まれ、何も除外されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 연결한 모든 대상이 여기에 표시되며, 원격 측정과 원격 구성도 포함됩니다. 빠지는 것은 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke bestemming waarmee de app contact heeft gehad, verschijnt hier, inclusief telemetrie en externe configuratie. Er wordt niets weggelaten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo destino que o app contatou aparece aqui, inclusive os de telemetria e configuração remota. Nada é omitido."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os destinos que a app contactou aparecem aqui, incluindo telemetria e configuração remota. Nada fica de fora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь показан каждый адрес, к которому обращалось приложение, включая телеметрию и удаленную конфигурацию. Ничего не скрыто."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla destinationer som appen kontaktat visas här, inklusive telemetri och fjärrkonfiguration. Inget utelämnas."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 聯絡過的每個目的地都會顯示在這裡，包括遙測與遠端設定，無一遺漏。"
          }
        }
      }
    },
    "Every export is recorded in the Audit, with its format and whether it carried a token." : {
      "comment" : "Network audit export: every export is audited.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Export wird im Audit erfasst, mit Format und Angabe, ob er ein Token enthielt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada exportación queda registrada en la Auditoría, con su formato y si llevaba un token."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada exportación queda registrada en la Auditoría, con su formato y si llevaba un token."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque export est enregistré dans l’Audit, avec son format et s’il contenait un jeton."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni esportazione viene registrata nell'Audit, con il formato e l'indicazione se conteneva un token."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての書き出しは、形式とトークンを含んだかどうかとともに監査に記録されます。"
          }
        },
        "ko" : {
