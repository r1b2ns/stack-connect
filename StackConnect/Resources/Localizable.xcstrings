          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impresiones, vistas de la página del producto y cómo los usuarios encuentran tu app e interactúan con ella en el App Store."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
