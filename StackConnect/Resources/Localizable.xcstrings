    "Reducing to %lld days deletes %lld events recorded before %@ now. This can't be undone." : {
      "comment" : "Network audit: confirmation of a shorter retention. Arguments: days, event count, cutoff date.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch die Verkürzung auf %lld Tage werden jetzt %lld Ereignisse gelöscht, die vor dem %@ aufgezeichnet wurden. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reducir a %lld días elimina ahora %lld eventos registrados antes del %@. Esta acción no se puede deshacer."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reducir a %1$lld días elimina ahora %2$lld eventos registrados antes del %3$@. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer à %lld jours supprime maintenant %lld événements enregistrés avant le %@. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riducendo a %lld giorni verranno eliminati subito %lld eventi registrati prima del %@. Questa azione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 日に短縮すると、%@ より前に記録された %lld 件のイベントが今すぐ削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld일로 줄이면 %@ 이전에 기록된 이벤트 %lld개가 지금 삭제됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkorten naar %lld dagen verwijdert nu %lld gebeurtenissen die vóór %@ zijn vastgelegd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduzir para %lld dias apaga agora %lld eventos anteriores a %@. Isso não pode ser desfeito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduzir para %lld dias elimina agora %lld eventos registados antes de %@. Isto não pode ser anulado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При сокращении до %lld дн. будут удалены события (%lld), записанные до %@. Это нельзя отменить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
