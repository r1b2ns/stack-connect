    "Requested %@. Apple usually publishes analytics data within 24–48 hours of the request." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angefordert am %@. Apple veröffentlicht Analytics-Daten normalerweise innerhalb von 24–48 Stunden nach der Anfrage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitado el %@. Apple suele publicar los datos de analíticas en un plazo de 24–48 horas tras la solicitud."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitado el %@. Apple suele publicar los datos de Analytics entre 24 y 48 horas después de la solicitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandé le %@. Apple publie généralement les données Analytics dans les 24 à 48 heures suivant la demande."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiesto il %@. Apple in genere pubblica i dati di analisi entro 24–48 ore dalla richiesta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ にリクエストしました。Apple は通常、リクエストから 24〜48 時間以内にアナリティクスデータを公開します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 요청함. Apple은 보통 요청 후 24~48시간 이내에 분석 데이터를 게시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aangevraagd op %@. Apple publiceert analysegegevens doorgaans binnen 24–48 uur na de aanvraag."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitado %@. A Apple geralmente publica os dados de análise em 24–48 horas após a solicitação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedido em %@. Normalmente, a Apple publica os dados de análise 24–48 horas após o pedido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрошено %@. Обычно Apple публикует данные аналитики в течение 24–48 часов после запроса."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begärd %@. Apple publicerar vanligtvis analysdata inom 24–48 timmar efter begäran."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已於 %@ 要求。Apple 通常會在要求後 24 至 48 小時內發佈分析資料。"
          }
        }
      }
    },
    "Requested %@. This is taking longer than the usual 24–48 hours — some report types aren't produced for every app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angefordert am %@. Dies dauert länger als die üblichen 24–48 Stunden – einige Berichtstypen werden nicht für jede App erstellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitado el %@. Está tardando más de las 24–48 horas habituales: algunos tipos de informe no se generan para todas las apps."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitado el %@. Está tardando más de las 24 a 48 horas habituales; algunos tipos de reporte no se generan para todas las apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandé le %@. Cela prend plus de temps que les 24 à 48 heures habituelles — certains types de rapports ne sont pas produits pour toutes les apps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiesto il %@. Sta richiedendo più delle consuete 24–48 ore: alcuni tipi di report non vengono generati per tutte le app."
