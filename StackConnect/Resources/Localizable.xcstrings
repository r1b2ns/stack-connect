        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect があなたの Google パスワードを知ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect는 Google 비밀번호를 절대 볼 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect ziet je Google-wachtwoord nooit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O StackConnect nunca vê a sua senha do Google."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O StackConnect nunca vê a sua palavra-passe Google."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect никогда не видит ваш пароль Google."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect ser aldrig ditt Google-lösenord."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect 絕不會看到你的 Google 密碼。"
          }
        }
      }
    },
    "StackConnect sends anonymous usage analytics and crash reports. They never include credentials, and you can turn them off in Settings." : {
      "comment" : "Connection guide, page 2 footnote. Must stay consistent with the App Privacy label (analytics and crash data are collected).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect sendet anonyme Nutzungsanalysen und Absturzberichte. Sie enthalten nie Zugangsdaten und lassen sich in den Einstellungen ausschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect sends anonymous usage analytics and crash reports. They never include credentials, and you can turn them off in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect envía análisis de uso anónimos e informes de fallos. Nunca incluyen credenciales y puedes desactivarlos en Ajustes."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect envía análisis de uso anónimos y reportes de fallas. Nunca incluyen credenciales y puedes desactivarlos en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect envoie des données d’utilisation anonymes et des rapports de plantage. Ils n’incluent jamais d’identifiants, et vous pouvez les désactiver dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect invia analisi di utilizzo anonime e report sugli arresti anomali. Non includono mai credenziali e puoi disattivarli in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect は匿名の使用状況データとクラッシュレポートを送信します。認証情報が含まれることはなく、「設定」でオフにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect는 익명의 사용 분석 데이터와 충돌 보고서를 보냅니다. 자격 증명은 절대 포함되지 않으며, 설정에서 끌 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect verstuurt anonieme gebruiksanalyses en crashrapporten. Daarin staan nooit inloggegevens, en je kunt ze uitzetten in Instellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O StackConnect envia dados de uso anônimos e relatórios de falhas. Eles nunca incluem credenciais, e você pode desativá-los em Ajustes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O StackConnect envia dados de utilização anónimos e relatórios de falhas. Nunca incluem credenciais e pode desativá-los nas Definições."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect отправляет анонимную аналитику использования и отчеты о сбоях. В них никогда нет учетных данных, и их можно отключить в настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect skickar anonym användningsanalys och kraschrapporter. De innehåller aldrig inloggningsuppgifter, och du kan stänga av dem i Inställningar."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect 會傳送匿名的使用分析與當機報告。其中絕不包含憑證，你也可以在「設定」中關閉。"
          }
        }
      }
    },
    "StackConnect sends your password only to Apple. It's saved only if you choose to, in the Keychain on this device only, never synced or exported." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect sendet dein Passwort nur an Apple. Es wird nur gespeichert, wenn du das möchtest, und zwar nur im Schlüsselbund dieses Geräts, nie synchronisiert oder exportiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect solo envía tu contraseña a Apple. Solo se guarda si tú lo eliges, únicamente en el llavero de este dispositivo, sin sincronizarse ni exportarse."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect solo envía tu contraseña a Apple. Solo se guarda si tú lo eliges, únicamente en el llavero de este dispositivo, sin sincronizarse ni exportarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect envoie votre mot de passe uniquement à Apple. Il n'est enregistré que si vous le choisissez, dans le trousseau de cet appareil seulement, jamais synchronisé ni exporté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect invia la password solo ad Apple. Viene salvata solo se lo scegli, unicamente nel portachiavi di questo dispositivo, mai sincronizzata né esportata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect はパスワードを Apple にのみ送信します。保存するのは選択した場合のみで、このデバイスのキーチェーンにだけ保存され、同期やエクスポートはされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect는 암호를 Apple에만 보냅니다. 저장을 선택한 경우에만 이 기기의 키체인에 저장되며 동기화되거나 내보내지지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect stuurt je wachtwoord alleen naar Apple. Het wordt alleen bewaard als je daarvoor kiest, uitsluitend in de sleutelhanger van dit apparaat, nooit gesynchroniseerd of geëxporteerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O StackConnect envia sua senha somente para a Apple. Ela só é salva se você escolher, apenas nas Chaves deste dispositivo, sem sincronização nem exportação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O StackConnect envia a sua palavra-passe apenas à Apple. Só fica guardada se o escolher, apenas no porta-chaves deste dispositivo, nunca sincronizada nem exportada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect отправляет пароль только в Apple. Он сохраняется, только если вы этого хотите, и только в связке ключей этого устройства, без синхронизации и экспорта."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect skickar ditt lösenord bara till Apple. Det sparas bara om du väljer det, endast i nyckelringen på den här enheten, aldrig synkat eller exporterat."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StackConnect 只會把你的密碼傳送給 Apple。只有在你選擇儲存時，密碼才會儲存在此裝置的鑰匙圈中，不會同步或匯出。"
          }
        }
      }
    },
