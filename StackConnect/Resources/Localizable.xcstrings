    "What you use to connect to %@ is kept on this device and used only for that." : {
      "comment" : "Connection guide, page 2. The placeholder is the service being connected, e.g. Firebase.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was du zum Verbinden mit %@ verwendest, bleibt auf diesem Gerät und wird nur dafür genutzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you use to connect to %@ is kept on this device and used only for that."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que usas para conectarte a %@ se queda en este dispositivo y solo se usa para eso."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que usas para conectarte a %@ se queda en este dispositivo y solo se usa para eso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que vous utilisez pour vous connecter à %@ reste sur cet appareil et ne sert qu’à cela."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che usi per connetterti con %@ resta su questo dispositivo e serve solo a quello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ への接続に使う情報はこのデバイスに保存され、その目的にだけ使われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 연결하는 데 사용하는 정보는 이 기기에 보관되며 그 목적으로만 사용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat je gebruikt om verbinding te maken met %@, blijft op dit apparaat en wordt alleen daarvoor gebruikt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que você usa para se conectar ao %@ fica neste dispositivo e só é usado para isso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que usa para ligar ao %@ fica neste dispositivo e só é usado para isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "То, что вы используете для подключения к %@, хранится на этом устройстве и используется только для этого."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det du använder för att ansluta till %@ stannar på den här enheten och används bara till det."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你用來連線到 %@ 的資訊會保存在此裝置上，且只用於此用途。"
          }
        }
      }
