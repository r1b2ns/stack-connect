// Version (shared with the widget extension)
#include "Version.xcconfig"

// Bundle identity & signing
APP_DISPLAY_NAME = StackConnect
PRODUCT_BUNDLE_IDENTIFIER = zeroSixteen.stackconnect
PRODUCT_BUNDLE_IDENTIFIER_TESTS = zeroSixteen.stackconnect.tests
DEVELOPMENT_TEAM = VVAVW2S9CF
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Distribution
PROVISIONING_PROFILE_SPECIFIER = match AppStore zeroSixteen.stackconnect

// The widget extension's profile (project.yml). Its bundle id is always
// $(PRODUCT_BUNDLE_IDENTIFIER).widget and it signs with the team, style and
// identity above.
WIDGET_PROVISIONING_PROFILE_SPECIFIER = match AppStore zeroSixteen.stackconnect.widget

// App Group shared by the app and the widget (SwiftData store, widget snapshot,
// shared flags). Expanded into both .entitlements files and exposed to the code
// as the Info.plist key AppGroupIdentifier, read by StackCore's AppGroup.
APP_GROUP_IDENTIFIER = group.zeroSixteen.stackconnect

// Sign in with Google (plan google-sign-in.md G1, G8): the iOS OAuth client ID
// (public; iOS clients have no secret). Exposed to the app as the Info.plist
// key GoogleOAuthClientID (project.yml) and read by GoogleOAuthConfiguration.
// Spike Cloud project for now: swap here once the production project exists.
GOOGLE_OAUTH_CLIENT_ID = 825216743615-s98fqhfl3l70uilpobd5joa8f4k26790.apps.googleusercontent.com
